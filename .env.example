# Copy to .env and change passwords (must satisfy SQL Server complexity rules)
MSSQL_SA_PASSWORD=ChangeMe_Str0ng!Pass
SYMDS_DB_PASSWORD=Symds_Str0ng!Pass1
MONITOR_RO_PASSWORD=Monitor_Str0ng!Pass1
MSSQL_PORT=14330
SYM_SOURCE_PORT=41415
SYM_TARGET_PORT=41416
MONITOR_PORT=18080

# --- Monitor UI sign-in (the UI can write to databases: change this password) ---
MONITOR_ADMIN_USER=admin
MONITOR_ADMIN_PASSWORD=Admin_Str0ng!Pass1
# Encryption key for saved connection passwords. Leave empty to auto-generate (stored in the monitor-data volume).
MONITOR_SECRET=
# Port of the SymmetricDS server that runs UI-created syncs (only for debugging)
RUNTIME_PORT=41417
# 127.0.0.1 = UI reachable from this PC only. 0.0.0.0 = reachable from the network (not recommended).
MONITOR_BIND=127.0.0.1
# Optional second SQL Server (profile extra-sql), reachable from Windows as localhost,14331
MSSQL2_PORT=14331
